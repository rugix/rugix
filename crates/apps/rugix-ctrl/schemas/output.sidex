import apps::AppStatus
import apps::AppState

#[rust(type = "::serde_json::Value")]
opaque JsonValue

/// Information about the system.
record SystemInfoOutput {
    /// Information about the slots.
    slots: [string: SlotInfoOutput],
    /// Information about the boot flow.
    boot?: BootInfoOutput,
    /// Information about the state management mechanism.
    state: StateInfoOutput,
}

/// Information about the state management mechanism.
#[json(tag = "status")]
variant StateInfoOutput {
    /// State management is disabled.
    Disabled,
    /// State management is active.
    Active: StateInfoActiveOutput,
    /// State management is inactive due to an error.
    Error: StateInfoErrorOutput,
}

/// Information about the state management mechanism, if state management is active.
record StateInfoActiveOutput {
    /// Device backing the data partition, if any.
    data_partition?: string,
}

/// Information about a state management error.
record StateInfoErrorOutput {
    /// Human-readable description of the error.
    message?: string,
    /// Whether state is temporarily stored in memory and may not persist.
    ephemeral?: bool,
}

/// Information about a slot.
record SlotInfoOutput {
    /// Indicates whether the slot is active, i.e., in use.
    active?: bool,
    /// Hashes of the slot data according to the slot database.
    hashes?: [string: string],
    /// Size of the slot data according to the slot database.
    size?: u64,
    /// Last time the slot has been updated according to the slot database.
    updated_at?: string,
}

/// Information about the boot flow.
record BootInfoOutput {
    /// Name of the boot flow.
    boot_flow: string,
    /// Active boot group.
    active_group?: string,
    /// Default boot group.
    default_group?: string,
    /// Information about the boot groups.
    groups: [string: BootGroupInfoOutput],
}

/// Information about a boot group.
record BootGroupInfoOutput {}

/// Information about a block device.
record BlockDeviceInfo {
    /// Path of the block device in `/dev`.
    device: string,
    /// Parent of the block device, if any.
    parent?: string,
    /// Partition number, if the block device is a partition.
    partition?: u32,
}

/// Entry in the app list output.
record AppListEntryOutput {
    /// Live workload status.
    status: AppStatus,
    /// Currently active generation number, if any.
    generation?: u64,
    /// Metadata of the active generation, if any.
    metadata?: JsonValue,
}

/// Output of the app info command (`apps info`).
record AppInfoOutput {
    /// App name.
    name: string,
    /// Live workload status.
    status: AppStatus,
    /// Persisted app state.
    state: AppState,
    /// All generations of the app.
    generations: [GenerationInfoOutput],
}

/// Information about a generation.
record GenerationInfoOutput {
    /// Generation number.
    number: u64,
    /// Creation timestamp (RFC 3339).
    created_at: string,
    /// Whether the generation is complete (fully installed).
    complete: bool,
    /// Timestamp of the last successful activation (RFC 3339), if any.
    last_activated?: string,
    /// Whether this is the currently active generation.
    active: bool,
    /// User-supplied metadata from `app-meta.json`, if present.
    metadata?: JsonValue,
}

/// Garbage collection result for a single app.
record AppGcAppOutput {
    /// Generation numbers that were removed.
    removed: [u64],
}

/// Output for component inventory commands.
record ComponentsOutput {
    /// Component roots that were scanned.
    roots: [ComponentRootOutput],
    /// Components loaded from the scanned roots.
    components: [LoadedComponentOutput],
}

/// Output of the component consistency check command.
record ComponentsCheckOutput {
    /// Component roots that were scanned.
    roots: [ComponentRootOutput],
    /// Components loaded from the scanned roots.
    components: [LoadedComponentOutput],
    /// Whether the loaded component set is internally consistent.
    consistent: bool,
    /// Problems found while checking the component set.
    problems: [ComponentProblemOutput],
}

/// Root directory scanned for component metadata.
record ComponentRootOutput {
    /// Kind of component source.
    kind: ComponentSourceKindOutput,
    /// Root path.
    path: string,
    /// App name for app-owned roots.
    app?: string,
    /// Active app generation for app-owned roots.
    generation?: u64,
}

/// Component loaded from a source.
record LoadedComponentOutput {
    /// Source from which the component was loaded.
    source: ComponentSourceOutput,
    /// Loaded component declaration.
    component: ComponentOutput,
}

/// Source for a component declaration.
record ComponentSourceOutput {
    /// Kind of component source.
    kind: ComponentSourceKindOutput,
    /// Source path or identifier.
    path: string,
    /// App name for app-owned sources.
    app?: string,
    /// Active app generation for app-owned sources.
    generation?: u64,
}

/// Kind of component source.
#[json(tagged = externally)]
variant ComponentSourceKindOutput {
    /// Components installed as part of the system image.
    System,
    /// Persistent local or admin-provided components.
    Local,
    /// Runtime-generated components.
    Runtime,
    /// Component metadata owned by an active app generation.
    App,
    /// Component metadata declared by a bundle.
    Bundle,
    /// Component metadata synthesized by Rugix Ctrl.
    Synthetic,
}

/// Component declaration.
record ComponentOutput {
    /// Component ID.
    id: string,
    /// Component version, if any.
    version?: string,
    /// Explicit capabilities provided by the component.
    provides: [CapabilityOutput],
    /// Exclusive resource claims declared by the component.
    claims: [ClaimOutput],
    /// Requirement selectors declared by the component.
    requires: [CapabilitySelectorOutput],
    /// Conflict selectors declared by the component.
    conflicts: [CapabilitySelectorOutput],
}

/// Exclusive resource claim.
record ClaimOutput {
    /// Claim ID.
    id: string,
}

/// Provided capability.
record CapabilityOutput {
    /// Capability ID.
    id: string,
    /// Capability version, if any.
    version?: string,
    /// Capability value, if any.
    value?: string,
}

/// Capability selector used by requirements and conflicts.
record CapabilitySelectorOutput {
    /// Capability ID selected by the selector.
    id: string,
    /// Version requirement, if any.
    version?: string,
    /// Value matched by the selector, if any.
    value?: string,
}

/// Internal consistency problem in the component set.
#[json(tag = "kind")]
variant ComponentProblemOutput {
    /// More than one component uses the same component ID.
    DuplicateComponent: DuplicateComponentProblemOutput,
    /// More than one component claims the same exclusive resource.
    DuplicateClaim: DuplicateClaimProblemOutput,
    /// A requirement selector was not satisfied.
    UnsatisfiedRequirement: UnsatisfiedRequirementProblemOutput,
    /// A conflict selector matched a provided capability.
    Conflict: ComponentConflictProblemOutput,
}

/// Duplicate component ID problem.
record DuplicateComponentProblemOutput {
    /// Duplicate component ID.
    id: string,
    /// Sources declaring the duplicate component ID.
    sources: [ComponentSourceOutput],
}

/// Duplicate exclusive resource claim problem.
record DuplicateClaimProblemOutput {
    /// Duplicate claim ID.
    id: string,
    /// Components declaring the duplicate claim.
    components: [ComponentRefOutput],
}

/// Reference to a component and its source, if known.
record ComponentRefOutput {
    /// Component ID.
    id: string,
    /// Source of the component, if known.
    source?: ComponentSourceOutput,
}

/// Unsatisfied requirement problem.
record UnsatisfiedRequirementProblemOutput {
    /// Component declaring the requirement selector.
    component: ComponentRefOutput,
    /// Requirement selector that was not satisfied.
    selector: CapabilitySelectorOutput,
}

/// Conflict problem.
record ComponentConflictProblemOutput {
    /// Component declaring the conflict selector.
    component: ComponentRefOutput,
    /// Conflict selector that matched.
    selector: CapabilitySelectorOutput,
    /// Component providing the conflicting capability.
    provider: ComponentRefOutput,
    /// Capability matched by the conflict selector.
    capability: CapabilityOutput,
}
