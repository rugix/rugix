/// Rugix Apps configuration.
#[json(rename_all = "kebab-case")]
record AppsConfig {
    /// The service manager available on the system (e.g., `"systemd"`).
    ///
    /// Defaults to `"none"`.
    service_manager?: string,
}

/// Persisted app state.
#[json(tag = "state", rename_all = "lowercase")]
variant AppState {
    /// No generation is active.
    Inactive,
    /// A transition is in progress.
    Switching: AppStateSwitching,
    /// A generation is active.
    Active: AppStateActive,
    /// The workload is being started.
    Starting: AppStateStarting,
    /// The workload is being stopped.
    Stopping: AppStateStopping,
    /// A transition and automatic rollback both failed.
    Error: AppStateError,
}

/// Details of a starting state.
record AppStateStarting {
    /// The active generation number.
    generation: u64,
    /// The active configuration revision, if any.
    configuration_revision?: u64,
}

/// Details of a stopping state.
record AppStateStopping {
    /// The active generation number.
    generation: u64,
    /// The active configuration revision, if any.
    configuration_revision?: u64,
}

/// Details of a switching state.
record AppStateSwitching {
    /// Generation being deactivated, if any.
    from?: u64,
    /// Configuration revision being deactivated, if any.
    from_configuration_revision?: u64,
    /// Generation being activated, if any.
    to?: u64,
    /// Configuration revision being activated, if any.
    to_configuration_revision?: u64,
    /// Whether this switch is a recovery attempt.
    recovery?: bool,
}

/// Details of an active state.
record AppStateActive {
    /// The active generation number.
    generation: u64,
    /// The active configuration revision, if any.
    configuration_revision?: u64,
}

/// Details of an error state.
record AppStateError {
    /// The generation that was previously active before the failed switch, if any.
    from?: u64,
    /// The configuration revision that was active before the failed switch, if any.
    from_configuration_revision?: u64,
    /// The generation that failed to activate.
    to: u64,
    /// The configuration revision that failed to activate, if any.
    to_configuration_revision?: u64,
    /// Human-readable error description.
    message: string,
}

/// Live workload status.
#[json(tag = "state", rename_all = "lowercase")]
variant AppStatus {
    /// The workload is running and healthy.
    Running,
    /// The workload is running but failing health checks.
    Unhealthy: AppStatusMessage,
    /// The workload is not running.
    Stopped,
    /// The workload has failed.
    Failed: AppStatusMessage,
    /// The status could not be determined.
    Unknown,
}

/// Details for a status with a message.
record AppStatusMessage {
    /// Human-readable description.
    message: string,
}

/// Metadata for a single generation, persisted in `.rugix/generation.json`.
#[json(rename_all = "camelCase")]
record AppGeneration {
    /// Generation number.
    number: u64,
    /// Creation timestamp (RFC 3339).
    created_at: string,
    /// Timestamp of the last successful activation (RFC 3339), if any.
    last_activated?: string,
    /// Configuration revision used for the last successful activation, if any.
    configuration_revision?: u64,
    /// Origin of the generation, as supplied with `apps install --origin`.
    origin?: AppOrigin,
    /// Whether the generation was installed with `apps install --no-activate`.
    ///
    /// Garbage collection keeps such a generation until it is activated or a newer
    /// generation is activated.
    staged?: bool,
}

/// Arbitrary JSON document describing where a generation came from.
///
/// Rugix Ctrl stores it with the generation without interpreting it, so that the
/// tool that installed a generation can recognize it later.
alias AppOrigin: json

/// Arbitrary JSON application configuration.
#[json(type = "any")]
#[rust(type = "crate::apps::configuration::AppConfiguration")]
opaque AppConfiguration

/// Persisted desired application configuration revision.
#[json(rename_all = "camelCase")]
record AppConfigurationState {
    /// Desired configuration revision, if device-specific configuration exists.
    revision?: u64,
    /// Highest configuration revision ever allocated for this app.
    last_allocated_revision?: u64,
}
