/// Rugix Ctrl configuration.
record Config {
    /// Signature check configuration.
    signatures?: SignaturesConfig,
    /// Component compatibility policy.
    compatibility?: CompatibilityConfig,
}

record SignaturesConfig {
    /// Paths to root certificates.
    /// 
    roots: [string],
}

record CompatibilityConfig {
    /// Require update bundles to carry component metadata.
    require_bundle_components?: bool,
}
