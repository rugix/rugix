/// Events emitted by CLI tools.
#[json(tag = "event")]
variant Event {
    /// Emitted when the update progress changes.
    UpdateProgress: UpdateProgressEvent,
    /// Emitted when a component compatibility check is skipped.
    CompatibilityCheckSkipped: CompatibilityCheckSkippedEvent,
    /// Emitted after an explicit app activation attempt.
    AppActivationResult: AppActivationResultEvent,
}

/// Event emitted when the update progress changes.
record UpdateProgressEvent {
    /// The update progress.
    progress: f64,
}

/// Reason a component compatibility check was skipped.
record CompatibilityCheckSkippedEvent {
    /// Update scope, such as `system` or `app`.
    scope: string,
    /// Human-readable skip reason.
    reason: string,
}

/// Result of an explicit app activation attempt.
record AppActivationResultEvent {
    /// App name.
    app: string,
    /// Requested generation.
    generation: u64,
    /// One of `activated`, `rolled-back`, `failed`, or `rollback-failed`.
    outcome: string,
}
