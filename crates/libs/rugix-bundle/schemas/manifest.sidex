#[rust(type="::sidex::serde::Serde<::si_crypto_hashes::HashAlgorithm>")]
#[json(type="string")]
opaque HashAlgorithm

#[rust(type="::sidex::serde::Serde<::si_crypto_hashes::HashDigest>")]
#[json(type="string")]
opaque HashDigest

#[rust(type="rugix_chunker::ChunkerAlgorithm")]
#[json(type="string")]
opaque ChunkerAlgorithm

#[rust(type="::sidex::serde::Serde<::byte_calc::NumBytes>")]
#[json(type="number")]
opaque NumBytes

#[json(rename_all="kebab-case")]
record BundleManifest {
    update_type: UpdateType,
    hash_algorithm?: HashAlgorithm,
    payloads: [Payload],
}

#[json(tagged=externally, rename_all="kebab-case")]
variant UpdateType {
    Full,
    Incremental
}

#[json(rename_all="kebab-case")]
record Payload {
    /// Payload configuration.
    delivery: DeliveryConfig,
    /// Filename of the payload file.
    filename: string,
    /// Block encoding.
    block_encoding?: BlockEncoding,
    /// Payload file has been delta encoded.
    /// 
    /// Specifies the delta encoding used to produce the payload file.
    delta_encoding?: DeltaEncoding,
}

#[json(rename_all="kebab-case")]
record DeltaEncoding {
    /// Inputs to the encoding.
    inputs: [DeltaEncodingInput],
    /// Delta encoding format.
    format: DeltaEncodingFormat,
    /// Hash of the decoded data.
    original_hash: HashDigest,
}

#[json(tagged=externally, rename_all="lowercase")]
variant DeltaEncodingFormat {
    /// Format emitted by Xdelta.
    /// 
    /// While Xdelta claims to use the VCDIFF format, the patches it produces are non-compliant.
    Xdelta,
}

record DeltaEncodingInput {
    /// Hashes to identify the input.
    hashes: [HashDigest],
}

#[json(tag="type", rename_all="kebab-case")]
variant DeliveryConfig {
    Slot: SlotDeliveryConfig,
    Execute: ExecuteDeliveryConfig,
    AppFile: AppFileDeliveryConfig,
    AppArchive: AppArchiveDeliveryConfig,
}

record SlotDeliveryConfig {
    /// Slot where the payload should be installed.
    slot: string,
}

record ExecuteDeliveryConfig {
    handler: [string]
}

record AppFileDeliveryConfig {
    /// App name.
    app: string,
    /// Relative path within the generation directory.
    path: string,
    /// Unix file mode (e.g., `755` for executables).
    ///
    /// Not supported for stored files.
    mode?: u32,
    /// Keep the file in the content-addressed store instead of the generation
    /// directory.
    ///
    /// Stored files are deduplicated and compressed across generations and apps.
    /// Orchestrators read them with `rugix-ctrl apps cat`.
    store?: bool,
}

record AppArchiveDeliveryConfig {
    /// App name.
    app: string,
}

#[json(rename_all="kebab-case")]
record BlockEncoding{
    chunker: ChunkerAlgorithm,
    /// Indicates whether to add a block index for the payload.
    hash_algorithm?: HashAlgorithm,
    /// Enable or disable block deduplication.
    deduplicate?: bool,
    compression?: Compression,
}

#[json(tag="type", rename_all="kebab-case")]
variant Compression {
    Xz: XzCompression,
}

record XzCompression {
    level?: u8,
}

/// App manifest (`app.toml`) inside a generation directory.
#[json(rename_all = "kebab-case")]
record AppManifest {
    /// Orchestrator to use (e.g., `"docker-compose"`, `"binary"`, `"generic"`).
    orchestrator: string,
    /// Health check configuration.
    health_check?: AppHealthCheckConfig,
    /// Application configuration files included in this generation.
    configuration?: AppConfigurationConfig,
    /// Docker Compose-specific orchestration configuration.
    docker_compose?: DockerComposeConfig,
}

/// Application configuration files included in an app generation.
#[json(rename_all = "kebab-case")]
record AppConfigurationConfig {
    /// Relative path to the optional JSON Schema.
    schema?: string,
    /// Relative path to the optional default JSON configuration.
    default?: string,
}

/// Docker Compose-specific orchestration configuration.
#[json(rename_all = "kebab-case")]
record DockerComposeConfig {
    /// Environment variables projected from the effective JSON configuration.
    ///
    /// Each map value is an RFC 6901 JSON Pointer.
    environment?: [string: string],
}

/// Health check configuration for an app.
#[json(rename_all = "kebab-case")]
record AppHealthCheckConfig {
    /// Timeout in seconds.  During activation, the orchestrator waits up to
    /// this many seconds for the workload to become healthy.
    /// Set to 0 to disable.  Default: 120.
    timeout?: u64,
}
