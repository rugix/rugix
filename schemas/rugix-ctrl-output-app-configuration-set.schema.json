{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rugix_ctrl.output.AppConfigurationSetOutput",
  "type": "object",
  "description": "Result of setting application configuration.",
  "properties": {
    "revision": {
      "type": [
        "integer",
        "string"
      ],
      "format": "uint64",
      "minimum": 0,
      "pattern": "^[0-9]+$"
    }
  },
  "required": [
    "revision"
  ],
  "unevaluatedProperties": false
}