{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rugix_ctrl.output.AppFileOutput",
  "type": "object",
  "description": "Payload file of an app generation (`apps files`).",
  "properties": {
    "path": {
      "type": "string"
    },
    "size": {
      "type": [
        "integer",
        "string"
      ],
      "format": "uint64",
      "minimum": 0,
      "pattern": "^[0-9]+$"
    },
    "hashes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "object": {
      "type": "string"
    }
  },
  "required": [
    "path",
    "hashes"
  ],
  "unevaluatedProperties": false
}