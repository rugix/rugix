{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rugix_bundle.manifest.BundleManifest",
  "type": "object",
  "properties": {
    "update-type": {
      "$ref": "#/$defs/rugix_bundle.manifest.UpdateType"
    },
    "hash-algorithm": {
      "$ref": "#/$defs/rugix_bundle.manifest.HashAlgorithm"
    },
    "payloads": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rugix_bundle.manifest.Payload"
      }
    }
  },
  "required": [
    "update-type",
    "payloads"
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "rugix_bundle.manifest.BlockEncoding": {
      "type": "object",
      "properties": {
        "chunker": {
          "$ref": "#/$defs/rugix_bundle.manifest.ChunkerAlgorithm"
        },
        "hash-algorithm": {
          "$ref": "#/$defs/rugix_bundle.manifest.HashAlgorithm"
        },
        "deduplicate": {
          "type": "boolean"
        },
        "compression": {
          "$ref": "#/$defs/rugix_bundle.manifest.Compression"
        }
      },
      "required": [
        "chunker"
      ],
      "unevaluatedProperties": false
    },
    "rugix_bundle.manifest.ChunkerAlgorithm": {
      "type": "string"
    },
    "rugix_bundle.manifest.Compression": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "xz"
            },
            "level": {
              "type": "integer",
              "maximum": 255,
              "minimum": 0
            }
          },
          "required": [
            "type"
          ]
        }
      ]
    },
    "rugix_bundle.manifest.DeliveryConfig": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "slot"
            },
            "slot": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "slot"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "execute"
            },
            "handler": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "type",
            "handler"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "app-file"
            },
            "app": {
              "type": "string"
            },
            "path": {
              "type": "string"
            },
            "mode": {
              "type": "integer",
              "format": "uint32",
              "maximum": 4294967295,
              "minimum": 0
            }
          },
          "required": [
            "type",
            "app",
            "path"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "app-archive"
            },
            "app": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "app"
          ]
        }
      ]
    },
    "rugix_bundle.manifest.DeltaEncoding": {
      "type": "object",
      "properties": {
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rugix_bundle.manifest.DeltaEncodingInput"
          }
        },
        "format": {
          "$ref": "#/$defs/rugix_bundle.manifest.DeltaEncodingFormat"
        },
        "original-hash": {
          "$ref": "#/$defs/rugix_bundle.manifest.HashDigest"
        }
      },
      "required": [
        "inputs",
        "format",
        "original-hash"
      ],
      "unevaluatedProperties": false
    },
    "rugix_bundle.manifest.DeltaEncodingFormat": {
      "enum": [
        "xdelta"
      ]
    },
    "rugix_bundle.manifest.DeltaEncodingInput": {
      "type": "object",
      "properties": {
        "hashes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rugix_bundle.manifest.HashDigest"
          }
        }
      },
      "required": [
        "hashes"
      ],
      "unevaluatedProperties": false
    },
    "rugix_bundle.manifest.HashAlgorithm": {
      "type": "string"
    },
    "rugix_bundle.manifest.HashDigest": {
      "type": "string"
    },
    "rugix_bundle.manifest.Payload": {
      "type": "object",
      "properties": {
        "delivery": {
          "$ref": "#/$defs/rugix_bundle.manifest.DeliveryConfig"
        },
        "filename": {
          "type": "string"
        },
        "block-encoding": {
          "$ref": "#/$defs/rugix_bundle.manifest.BlockEncoding"
        },
        "delta-encoding": {
          "$ref": "#/$defs/rugix_bundle.manifest.DeltaEncoding"
        }
      },
      "required": [
        "delivery",
        "filename"
      ],
      "unevaluatedProperties": false
    },
    "rugix_bundle.manifest.UpdateType": {
      "enum": [
        "full",
        "incremental"
      ]
    }
  }
}