{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rugix_ctrl.output.AppGcAppOutput",
  "type": "object",
  "description": "Garbage collection result for a single app.",
  "properties": {
    "removed": {
      "type": "array",
      "items": {
        "type": [
          "integer",
          "string"
        ],
        "format": "uint64",
        "minimum": 0,
        "pattern": "^[0-9]+$"
      }
    }
  },
  "required": [
    "removed"
  ],
  "unevaluatedProperties": false
}