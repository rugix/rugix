{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rugix_ctrl.output.SystemInfoOutput",
  "type": "object",
  "description": "Information about the system.",
  "properties": {
    "slots": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/rugix_ctrl.output.SlotInfoOutput"
      }
    },
    "boot": {
      "$ref": "#/$defs/rugix_ctrl.output.BootInfoOutput"
    },
    "state": {
      "$ref": "#/$defs/rugix_ctrl.output.StateInfoOutput"
    }
  },
  "required": [
    "slots",
    "state"
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "rugix_ctrl.output.BootGroupInfoOutput": {
      "$id": "rugix_ctrl.output.BootGroupInfoOutput",
      "type": "object",
      "description": "Information about a boot group.",
      "properties": {},
      "required": [],
      "unevaluatedProperties": false
    },
    "rugix_ctrl.output.BootInfoOutput": {
      "$id": "rugix_ctrl.output.BootInfoOutput",
      "type": "object",
      "description": "Information about the boot flow.",
      "properties": {
        "bootFlow": {
          "type": "string"
        },
        "activeGroup": {
          "type": "string"
        },
        "defaultGroup": {
          "type": "string"
        },
        "groups": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/rugix_ctrl.output.BootGroupInfoOutput"
          }
        }
      },
      "required": [
        "bootFlow",
        "groups"
      ],
      "unevaluatedProperties": false
    },
    "rugix_ctrl.output.SlotInfoOutput": {
      "$id": "rugix_ctrl.output.SlotInfoOutput",
      "type": "object",
      "description": "Information about a slot.",
      "properties": {
        "active": {
          "type": "boolean"
        },
        "hashes": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "size": {
          "type": "integer",
          "format": "uint64"
        },
        "updatedAt": {
          "type": "string"
        }
      },
      "required": [],
      "unevaluatedProperties": false
    },
    "rugix_ctrl.output.StateInfoOutput": {
      "$id": "rugix_ctrl.output.StateInfoOutput",
      "description": "Information about the state management mechanism.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "Disabled"
            }
          },
          "required": [
            "status"
          ]
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "Active"
            },
            "dataPartition": {
              "type": "string"
            }
          },
          "required": [
            "status"
          ]
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "Error"
            }
          },
          "required": [
            "status"
          ]
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "EphemeralFallback"
            }
          },
          "required": [
            "status"
          ]
        }
      ]
    }
  }
}