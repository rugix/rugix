#!/bin/sh
set -e

case "$1" in
    configure|abort-upgrade|abort-deconfigure|abort-remove)
        for unit in rugix-apps-restore-units.service rugix-apps-recover.service; do
            if deb-systemd-helper --quiet was-enabled "$unit"; then
                deb-systemd-helper enable "$unit" >/dev/null || true
            else
                deb-systemd-helper update-state "$unit" >/dev/null || true
            fi
        done

        if [ -z "${DPKG_ROOT:-}" ] && [ -d /run/systemd/system ]; then
            systemctl --system daemon-reload >/dev/null || true
            # These oneshot services must not replay recovery on every upgrade.
            deb-systemd-invoke start rugix-apps-restore-units.service rugix-apps-recover.service >/dev/null || true
        fi
        ;;
esac
